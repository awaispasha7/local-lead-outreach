# Copy to .env (gitignored) and fill in. Never commit .env.
SERPAPI_KEY=

# Any mailbox with IMAP + SMTP access. Examples:
#   Hostinger: imap.hostinger.com:993 / smtp.hostinger.com:465 (folders INBOX.Drafts / INBOX.Sent)
#   Zoho:      imap.zoho.com:993      / smtp.zoho.com:465
#   Gmail:     imap.gmail.com:993     / smtp.gmail.com:465 (use an app password; folders "[Gmail]/Drafts" / "[Gmail]/Sent Mail")
EMAIL_ADDRESS=
EMAIL_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
SMTP_HOST=
SMTP_PORT=465

# Run `python3 push_drafts.py --list-folders` to see your provider's exact folder names.
DRAFTS_FOLDER=Drafts
SENT_FOLDER=Sent
